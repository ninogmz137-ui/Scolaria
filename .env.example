# ⚠️ Toute variable EXPO_PUBLIC_* est embarquée EN CLAIR dans l'APK.
# N'y mets JAMAIS de clé d'API tierce. Anthropic (Aria) et Google Vision sont des secrets
# Supabase utilisés par les Edge Functions :
#   npx supabase secrets set ANTHROPIC_API_KEY=... --project-ref nmizwmymhqleasnxcyvu

# Supabase — base de données et authentification
# Trouve ces valeurs dans : https://supabase.com/dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

