# Anthropic API — pour Aria (assistant IA)
# Local : copie ce fichier en .env et remplace la valeur.
# EAS Build : crée EXPO_PUBLIC_ANTHROPIC_API_KEY dans Expo (expo.dev) → Variables d'environnement,
# pour chaque environnement utilisé par tes profils (development / preview / production). Voir eas.json → "environment".
EXPO_PUBLIC_ANTHROPIC_API_KEY=your-api-key-here

# Supabase — base de données et authentification
# Trouve ces valeurs dans : https://supabase.com/dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Vision AI — pour le scanner OCR de bulletins
# Obtiens ta clé sur : https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_VISION_KEY=your-google-vision-key-here
